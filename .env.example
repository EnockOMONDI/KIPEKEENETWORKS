# Supabase shared pooler URL. Use this for the web app and worker runtime.
DATABASE_URL="postgresql://postgres.cfrgznfjspowdomzjfsc:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session pooler URL. Use this for Prisma migrations when direct IPv6 is unreachable.
DIRECT_URL="postgresql://postgres.cfrgznfjspowdomzjfsc:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?connect_timeout=30"

# Public app URL. Set this to your Render URL after deployment.
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
KIPEKEE_APP_URL="http://127.0.0.1:3000"

# Render web app should use queue. Laptop/VPS worker still calls Hermes directly.
KIPEKEE_HERMES_MODE="profile"
KIPEKEE_HERMES_EXECUTION_MODE="queue"
KIPEKEE_SHARED_HERMES_PROFILE="kipekeenetworksworker"

# Worker-only values.
HERMES_BIN="/Users/djsean/.local/bin/hermes"
KIPEKEE_WORKER_ID="local-hermes-worker"
KIPEKEE_WORKER_POLL_MS="3000"

# Production uploads should use object storage. Keep local only for development.
KIPEKEE_STORAGE_PROVIDER="local"

# Seed-only admin values.
KIPEKEE_ADMIN_EMAIL="founder@kipekee.studio"
KIPEKEE_ADMIN_PASSWORD="change-this-before-production"
