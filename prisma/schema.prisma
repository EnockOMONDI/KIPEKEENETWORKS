generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String?
  role             String   @default("MEMBER")
  createdAt        DateTime @default(now())

  authSessions     AuthSession[]
  memberships      WorkspaceMember[]
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  uploadedArtifacts Artifact[]

  @@index([role])
}

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  type            String   @default("BUSINESS_GROUP")
  status          String   @default("ACTIVE")
  ownerUserId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User? @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members         WorkspaceMember[]
  companies       Company[]
  invites         TeamInvite[]
  artifacts       Artifact[]
  collections     KnowledgeCollection[]
  audits          AuditLog[]
  approvals       ApprovalRequest[]
  integrations    IntegrationConnection[]

  @@index([ownerUserId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("MEMBER")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, active])
}

model Company {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  slug            String   @unique
  type            String   @default("COMPANY")
  industryKey     String?
  countryCode     String?
  status          String   @default("ACTIVE")
  isolationTier   String   @default("PROFILE")
  hermesNamespace String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runtime         CompanyRuntime?
  invites         TeamInvite[]
  employees       CompanyEmployee[]
  artifacts       Artifact[]
  collections     KnowledgeCollection[]
  sessions        Session[]
  hermesJobs      HermesJob[]
  workflows       Workflow[]
  brandVoice      BrandVoice?
  businessRules   BusinessRule[]
  audits          AuditLog[]
  approvals       ApprovalRequest[]
  invoices        Invoice[]
  integrations    IntegrationConnection[]
  subscription    Subscription?
  mailboxes       Mailbox[]

  @@index([workspaceId])
  @@index([type])
  @@index([industryKey])
}

model CompanyRuntime {
  id              String   @id @default(cuid())
  workspaceId     String
  companyId       String   @unique
  runtimeType     String   @default("PROFILE")
  hermesProfile   String   @unique
  hermesHomePath  String?
  status          String   @default("PENDING")
  provisionedAt   DateTime?
  configVersion   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hermesJobs      HermesJob[]

  @@index([workspaceId, status])
}

model TeamInvite {
  id            String   @id @default(cuid())
  workspaceId   String
  companyId     String?
  name          String
  email         String
  role          String
  tokenHash     String   @unique
  invitedBy     String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  openedAt      DateTime?
  lastOpenedAt  DateTime?
  openCount     Int      @default(0)
  maxOpenCount  Int      @default(10)
  createdAt     DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([companyId])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingPackage {
  id                String   @id @default(cuid())
  name              String   @unique
  priceKes          Int?
  description       String
  includedEmployees Int?
  loopsEnabled      Boolean  @default(false)
  documentMemory    Boolean  @default(true)
  createdAt         DateTime @default(now())

  subscriptions     Subscription[]
}

model Subscription {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  onboardingPackageId String?
  monthlyUserPriceKes Int      @default(4500)
  paidUsers           Int      @default(1)
  setupFeeKes         Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company             Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  onboardingPackage   OnboardingPackage? @relation(fields: [onboardingPackageId], references: [id])
}

model EmployeeTemplate {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  defaultTools   String
  defaultSkills  String   @default("[]")
  createdAt      DateTime @default(now())

  employees      CompanyEmployee[]
}

model CompanyEmployee {
  id               String   @id @default(cuid())
  companyId        String
  templateId       String
  displayName      String
  roleInstructions String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  company          Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template         EmployeeTemplate @relation(fields: [templateId], references: [id])
  skills           EmployeeSkill[]
  workflows        EmployeeWorkflow[]
  artifactAccess   ArtifactAccess[]
  mailboxAccess    MailboxAccess[]
  sessions         Session[]
  hermesJobs       HermesJob[]

  @@index([companyId, active])
}

model Skill {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String
  category       String
  defaultToolsets String  @default("[]")
  skillPath      String?
  version        Int      @default(1)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  employees      EmployeeSkill[]
  workflowSteps  WorkflowStep[]
  templateSteps  WorkflowTemplateStep[]
  industrySkills IndustryTemplateSkill[]

  @@index([category, enabled])
}

model EmployeeSkill {
  id          String   @id @default(cuid())
  employeeId  String
  skillId     String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  employee    CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill       Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@index([skillId])
}

model Workflow {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  description    String
  status         String   @default("DRAFT")
  triggerType    String   @default("MANUAL")
  schedule       String?
  approvalPolicy String   @default("APPROVAL_REQUIRED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps          WorkflowStep[]
  employees      EmployeeWorkflow[]
  jobs           HermesJob[]
  sessions       Session[]
  rules          BusinessRule[]
  approvals      ApprovalRequest[]
  integrationAccess IntegrationAccess[]

  @@index([companyId, status])
}

model WorkflowTemplate {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String
  category       String
  defaultEmployeeName String
  triggerType    String   @default("MANUAL")
  schedule       String?
  approvalPolicy String   @default("APPROVAL_REQUIRED")
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps          WorkflowTemplateStep[]
  industries     IndustryTemplateWorkflow[]

  @@index([category, active])
}

model WorkflowTemplateStep {
  id                 String   @id @default(cuid())
  workflowTemplateId  String
  skillId            String?
  stepOrder          Int
  stepType           String   @default("SKILL")
  instruction        String
  inputMapping       String?
  outputMapping      String?
  requiresApproval   Boolean  @default(false)

  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  skill              Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([workflowTemplateId, stepOrder])
  @@index([skillId])
}

model IndustryTemplate {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String
  organisationTypes  String   @default("[]")
  countryCode        String?
  brandVoiceTone     String   @default("Clear, warm, professional")
  brandVoiceRules    String   @default("")
  businessRules      String   @default("[]")
  knowledgeCollections String @default("[]")
  recommendedEmployees String @default("[]")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills             IndustryTemplateSkill[]
  workflows          IndustryTemplateWorkflow[]

  @@index([active])
}

model IndustryTemplateSkill {
  id                 String   @id @default(cuid())
  industryTemplateId  String
  skillId            String
  recommended        Boolean  @default(true)
  createdAt          DateTime @default(now())

  industryTemplate   IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
  skill              Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([industryTemplateId, skillId])
  @@index([skillId])
}

model IndustryTemplateWorkflow {
  id                 String   @id @default(cuid())
  industryTemplateId  String
  workflowTemplateId  String
  recommended        Boolean  @default(true)
  createdAt          DateTime @default(now())

  industryTemplate   IndustryTemplate @relation(fields: [industryTemplateId], references: [id], onDelete: Cascade)
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@unique([industryTemplateId, workflowTemplateId])
  @@index([workflowTemplateId])
}

model WorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  skillId         String?
  stepOrder       Int
  stepType        String   @default("SKILL")
  instruction     String
  inputMapping    String?
  outputMapping   String?
  requiresApproval Boolean @default(false)

  workflow        Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  skill           Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([workflowId, stepOrder])
  @@index([skillId])
}

model EmployeeWorkflow {
  id          String   @id @default(cuid())
  employeeId  String
  workflowId  String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  employee    CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workflowId])
  @@index([workflowId])
}

model BrandVoice {
  id                    String   @id @default(cuid())
  companyId             String   @unique
  tone                  String   @default("Clear, warm, professional")
  styleRules            String   @default("")
  forbiddenWords        String   @default("")
  formattingPreferences String   @default("")
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company               Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model BusinessRule {
  id          String   @id @default(cuid())
  companyId   String
  workflowId  String?
  name        String
  category    String
  ruleText    String
  severity    String   @default("NORMAL")
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow    Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([companyId, active])
  @@index([workflowId])
}

model KnowledgeCollection {
  id          String   @id @default(cuid())
  workspaceId String?
  companyId   String?
  ownerType   String
  ownerId     String
  name        String
  category    String
  sensitivity String   @default("NORMAL")
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]
  chunks      KnowledgeChunk[]

  @@index([ownerType, ownerId])
  @@index([workspaceId])
  @@index([companyId])
}

model Artifact {
  id              String   @id @default(cuid())
  workspaceId     String?
  companyId       String?
  collectionId    String?
  uploadedByUserId String?
  title           String
  kind            String
  storagePath     String
  storageProvider String @default("local")
  fileSizeBytes   Int    @default(0)
  extractedText   String?
  memoryStatus    String @default("ARTIFACT_ONLY")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collection      KnowledgeCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  uploadedBy      User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  access          ArtifactAccess[]
  chunks          KnowledgeChunk[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([collectionId])
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  artifactId   String
  collectionId String
  text         String
  chunkIndex   Int
  metadata     String?
  createdAt    DateTime @default(now())

  artifact     Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([artifactId, chunkIndex])
  @@index([collectionId])
}

model ArtifactAccess {
  id             String   @id @default(cuid())
  artifactId     String
  employeeId     String
  canUseAsMemory Boolean  @default(false)
  createdAt      DateTime @default(now())

  artifact       Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  employee       CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([artifactId, employeeId])
  @@index([employeeId, canUseAsMemory])
}

model Session {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  employeeId  String
  workflowId  String?
  title       String
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workflow    Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  messages    Message[]
  hermesJobs  HermesJob[]

  @@index([workspaceId, companyId])
  @@index([employeeId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model HermesJob {
  id                 String   @id @default(cuid())
  workspaceId        String
  companyId          String
  companyRuntimeId   String
  employeeId         String
  sessionId          String
  workflowId         String?
  prompt             String
  employeeName       String
  companyName        String
  runtimeProfile     String
  skillKeys          String   @default("[]")
  allowedArtifactIds String   @default("[]")
  allowedToolsets    String   @default("[]")
  memoryContext      String?
  jobSignature       String?
  status             String   @default("PENDING")
  result             String?
  error              String?
  lockedAt           DateTime?
  lockedBy           String?
  attempts           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  completedAt        DateTime?

  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runtime            CompanyRuntime @relation(fields: [companyRuntimeId], references: [id], onDelete: Cascade)
  employee           CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  session            Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workflow           Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([companyRuntimeId])
}

model WorkerHeartbeat {
  id           String   @id @default(cuid())
  workerId     String   @unique
  runtime      String   @default("local")
  status       String   @default("ONLINE")
  currentJobId String?
  lastSeenAt   DateTime @default(now())
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, lastSeenAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  companyId   String?
  actor       String
  action      String
  target      String
  metadata    String?
  createdAt   DateTime @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([companyId])
}

model ApprovalRequest {
  id           String   @id @default(cuid())
  workspaceId  String
  companyId    String
  workflowId   String?
  emailDraftId String?
  title        String
  details      String
  status       String   @default("PENDING")
  requestedBy  String
  createdAt    DateTime @default(now())
  decidedAt    DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workflow     Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  emailDraft   EmailDraft? @relation(fields: [emailDraftId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([companyId, status])
}

model Invoice {
  id          String   @id @default(cuid())
  companyId   String
  invoiceNo   String   @unique
  description String
  amountKes   Int
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id                   String   @id @default(cuid())
  ownerType            String
  ownerId              String
  userId               String?
  workspaceId          String?
  companyId            String?
  provider             String
  accountEmail         String?
  displayName          String
  status               String   @default("PLANNED")
  encryptedCredentials String?
  scopes               String
  connectedBy          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace            Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company              Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  access               IntegrationAccess[]
  mailboxes            Mailbox[]

  @@index([ownerType, ownerId])
  @@index([workspaceId])
  @@index([companyId])
}

model IntegrationAccess {
  id            String   @id @default(cuid())
  connectionId  String
  companyId     String?
  employeeId    String?
  workflowId    String?
  permission    String   @default("READ")
  createdAt     DateTime @default(now())

  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  workflow      Workflow? @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([companyId])
  @@index([employeeId])
}

model Mailbox {
  id                      String   @id @default(cuid())
  companyId               String
  integrationConnectionId String
  emailAddress            String
  displayName             String
  provider                String
  status                  String   @default("PLANNED")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company                 Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integrationConnection   IntegrationConnection @relation(fields: [integrationConnectionId], references: [id], onDelete: Cascade)
  access                  MailboxAccess[]
  messages                EmailMessage[]

  @@unique([companyId, emailAddress])
  @@index([integrationConnectionId])
}

model MailboxAccess {
  id                    String   @id @default(cuid())
  mailboxId              String
  employeeId             String
  canRead                Boolean  @default(true)
  canDraft               Boolean  @default(true)
  canRequestSend         Boolean  @default(true)
  canSendWithoutApproval Boolean  @default(false)
  createdAt              DateTime @default(now())

  mailbox                Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  employee               CompanyEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, employeeId])
  @@index([employeeId])
}

model EmailMessage {
  id                String   @id @default(cuid())
  mailboxId          String
  externalMessageId  String
  fromAddress        String
  toAddresses        String
  ccAddresses        String?
  subject            String
  bodySnippet        String?
  receivedAt         DateTime
  status             String   @default("NEW")
  createdAt          DateTime @default(now())

  mailbox            Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  drafts             EmailDraft[]

  @@unique([mailboxId, externalMessageId])
  @@index([mailboxId, receivedAt])
}

model EmailDraft {
  id           String   @id @default(cuid())
  messageId    String
  employeeId   String
  draftSubject String
  draftBody    String
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  message      EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  approvals    ApprovalRequest[]

  @@index([employeeId, status])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String   @unique
  action    String
  subject   String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([action, resetAt])
}
